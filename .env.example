# CropShield AI Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="CropShield AI"
VERSION=1.0.0
SECRET_KEY="cropshield-super-secret-production-key-2025-secure"

# Database: SQLite out-of-the-box (zero configuration needed)
# For Supabase / PostgreSQL deployment:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./cropshield.db"

# Storage
UPLOAD_DIR="./uploads"
MODEL_DIR="./models"

# Weather API (Open-Meteo is free & keyless, optional OpenWeatherMap key)
OPENWEATHER_API_KEY=""

# Frontend API URL
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
